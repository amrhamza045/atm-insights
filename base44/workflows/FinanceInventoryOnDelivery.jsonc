{
  "name": "Finance Inventory on Catering Delivery",
  "description": "Recognize confirmed catering delivery quantities at original completed batch or requisition issue costs, without crediting inventory more than once.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "CateringCustodyCheckpoint",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.stage == \"delivered\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "finance_inventory_on_catering_delivery",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "settle": {
          "wait": "PT30S",
          "then": "post",
          "x-base44": {
            "title": "Let custody confirmation finish"
          }
        }
      },
      {
        "post": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "financeAutoPost",
            "args": {
              "inventory_entity": "CateringCustodyCheckpoint",
              "source_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check_retry",
          "x-base44": {
            "title": "Value delivered stock from original cost"
          }
        }
      },
      {
        "check_retry": {
          "switch": [
            {
              "when": "${ .post.retry == true }",
              "then": "delay"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Retry temporary contention?"
          }
        }
      },
      {
        "delay": {
          "wait": "PT15S",
          "then": "retry",
          "x-base44": {
            "title": "Wait for company posting lock"
          }
        }
      },
      {
        "retry": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "financeAutoPost",
            "args": {
              "inventory_entity": "CateringCustodyCheckpoint",
              "source_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Retry delivery COGS once"
          }
        }
      }
    ]
  }
}