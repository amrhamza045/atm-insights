{
  "name": "Catering Actual Costs on Waste",
  "description": "Refresh event actuals after event-linked waste changes, including approvals, edits and deletion.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "WasteDeclaration",
      "events": [
        "create",
        "update",
        "delete"
      ]
    },
    "condition": "${ (.trigger.data.event_id // .trigger.old_data.event_id // \"\") != \"\" or .trigger.payload_too_large == true }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "catering_actual_costs_waste",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "recompute": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recomputeCateringActualCosts",
            "args": {
              "event_id": "${ .trigger.data.event_id // .trigger.old_data.event_id // \"\" }",
              "previous_event_id": "${ .trigger.old_data.event_id // \"\" }",
              "source_type": "WasteDeclaration",
              "source_id": "${ .trigger.entity_id }",
              "source_deleted": "${ .trigger.event_type == \"delete\" }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Recompute actual event costs"
          }
        }
      }
    ]
  }
}