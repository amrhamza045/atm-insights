{
  "description": "Hourly tick; runs only at the hour set in Admin \u2192 Settings \u2192 Schedules (company timezone). Overwrites every account's permission copy with the resolver's result.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Permission Copy Nightly Safety Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "permission_copy_nightly",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_all": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncPermissionCopy",
            "args": {
              "trigger": "nightly",
              "all": true,
              "scheduled_tick": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Re-sync all accounts"
          }
        }
      }
    ]
  }
}