{
  "description": "Hourly tick; runs only at the day and hour set in Admin \u2192 Settings \u2192 Schedules (company timezone). Report-only scan for catering records whose parent event is missing.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Weekly Catering Orphan Scan",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_catering_orphan_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_and_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reportCateringOrphans",
            "args": {
              "notify": true,
              "scheduled_tick": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Scan catering links",
            "description": "Report-only orphan check"
          }
        }
      }
    ]
  }
}