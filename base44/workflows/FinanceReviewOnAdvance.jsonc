{
  "name": "Finance Review on Employee Advance",
  "description": "When an employee advance is approved, prepare its journal for Finance review.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "finance_review_on_advance",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "settle": {
          "wait": "PT20S",
          "then": "prepare",
          "x-base44": {
            "title": "Let the advance save finish"
          }
        }
      },
      {
        "prepare": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "financeAutoPost",
            "args": {
              "operational_entity": "EmployeeBorrowing",
              "source_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Prepare advance journal for review"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "EmployeeBorrowing"
    }
  }
}