{
  "description": "Hourly tick; emails the Daily Financial Summary only at the hour set in Admin \u2192 Settings \u2192 Schedules (company timezone).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Financial Summary Email",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_financial_summary_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "emailDailyFinancialSummary",
            "args": {
              "scheduled_tick": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email daily summary",
            "description": "At the scheduled hour"
          }
        }
      }
    ]
  }
}