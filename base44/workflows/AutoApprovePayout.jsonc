{
  "description": "Auto-approves a new payout request when auto-approval is on and the submitter can approve payouts.",
  "name": "Auto-approve Payout",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Payout"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_approve_payout",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "approve": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoApproveRequest",
            "args": {
              "entity": "Payout",
              "id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Auto-approve if permitted"
          }
        }
      }
    ]
  }
}