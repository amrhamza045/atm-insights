        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perm_is_central_admin": true
              }
            },
            {
              "user_condition": {
                "data.perm_is_staff": true
              }
            }
          ]
        }
      }
