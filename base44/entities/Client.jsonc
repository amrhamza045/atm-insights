{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Client's full name"
    },
    "client_type": {
      "type": "string",
      "enum": [
        "individual",
        "corporate"
      ],
      "default": "individual",
      "description": "Whether this client is a private individual or a company/organisation. Set manually by staff at registration or on edit \u2014 never inferred. Corporate clients are the ones that need billing terms, tax details and higher catering credit limits.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perm_is_central_admin": true
              }
            },
            {
              "user_condition": {
                "data.perm_is_staff": true
              }
            }
          ]
        }
      }
    },
    "email": {
      "type": "string",
      "description": "Client's email address. Staff-set (customer profiles get their account email from the registerClient backend function).",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perm_is_central_admin": true
              }
            },
            {
              "user_condition": {
                "data.perm_is_staff": true
              }
            }
          ]
        }
      }
    },
    "phone": {
      "type": "string",
      "description": "Client's phone number"
    },
    "address": {
      "type": "string",
      "description": "Client's delivery/home address"
    },
    "location_lat": {
      "type": "number",
      "description": "Latitude of client's location (optional)"
    },
    "location_lng": {
      "type": "number",
      "description": "Longitude of client's location (optional)"
    },
    "client_source": {
      "type": "string",
      "enum": [
        "web",
        "pos"
      ],
      "default": "pos",
      "description": "How the client was registered: web (self-registration online) or pos (created at point of sale)",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perm_is_central_admin": true
              }
            },
            {
              "user_condition": {
                "data.perm_is_staff": true
              }
            }
          ]
        }
      }
    },
    "national_id_url": {
      "type": "string",
      "description": "URL to scanned national ID or passport"
    },
    "referred_by": {
      "type": "string",
      "description": "ID of the client who referred this person",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perm_is_central_admin": true
              }
            },
            {
              "user_condition": {
                "data.perm_is_staff": true
              }
            }
          ]
        }
      }
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "Total amount spent at restaurant",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.perm_is_central_admin": true
              }
            },
            {
              "user_condition": {
                "data.perm_is_staff": true
              }
            }
          ]
        }
      }
    },
