      "default": false,
      "description": "True when this record was merged into another client record. Merged records are never deleted \u2014 they are kept, excluded from CRM lists and reporting, and remain recoverable if the merge turns out wrong.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
