{
  "name": "FinanceHealthReview",
  "type": "object",
  "properties": {
    "analysis_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "submitted_by_id": {
      "type": "string"
    },
    "proposed_status": {
      "type": "string"
    },
    "previous_status": {
      "type": "string"
    },
    "evidence_note": {
      "type": "string",
      "maxLength": 8000
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "static_review",
        "executed_test",
        "reconciliation",
        "owner_confirmation"
      ]
    },
    "actual": {
      "type": "string",
      "maxLength": 4000
    },
    "impact": {
      "type": "string",
      "maxLength": 2000
    },
    "remediation_note": {
      "type": "string",
      "maxLength": 4000
    },
    "owner": {
      "type": "string",
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "decision_note": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "analysis_id",
    "company_id",
    "finding_id",
    "submitted_by_id",
    "proposed_status",
    "evidence_note",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}