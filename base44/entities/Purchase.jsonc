{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID of the client who made the purchase"
    },
    "client_name": {
      "type": "string",
      "description": "Name of the client at time of purchase"
    },
    "amount": {
      "type": "number",
      "description": "Purchase amount"
    },
    "cashback_earned": {
      "type": "number",
      "default": 0,
      "description": "Cashback earned by referrer from this purchase"
    },
    "referrer_id": {
      "type": "string",
      "description": "ID of the referrer who earned cashback"
    },
    "referrer_name": {
      "type": "string",
      "description": "Name of the referrer"
    },
    "cashback_rate": {
      "type": "number",
      "description": "Cashback rate applied"
    }
  },
  "required": [
    "client_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_finance_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_actions": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_systems": true
          }
        },
        {
          "user_condition": {
            "data.perm_purchases_approve": true
          }
        },
        {
          "data.client_id": "{{user.data.perm_client_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_actions": true
          }
        },
        {
          "user_condition": {
            "data.perm_purchases_approve": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_finance_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        }
      ]
    }
  }
}