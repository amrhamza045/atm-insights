{
  "name": "MenuSection",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "ID of the branch this section belongs to (null = shared)"
    },
    "branch_name": {
      "type": "string",
      "description": "Name of the branch this section belongs to"
    },
    "name": {
      "type": "string",
      "description": "Section name (e.g., Starter, Food, Drinks, Desserts)"
    },
    "description": {
      "type": "string",
      "description": "Section description"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the default section shown"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this section is active"
    },
    "visible_website": {
      "type": "boolean",
      "default": true,
      "description": "Visible on customer website menu"
    },
    "visible_pos": {
      "type": "boolean",
      "default": true,
      "description": "Visible in POS system"
    },
    "tax_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Whether items in this section are exempt from tax"
    },
    "service_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Whether items in this section are exempt from service charge"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_is_staff": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_menu_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_settings": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_menu_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_settings": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_menu_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_settings": true
          }
        }
      ]
    }
  }
}