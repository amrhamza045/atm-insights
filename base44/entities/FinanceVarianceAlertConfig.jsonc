{
  "name": "FinanceVarianceAlertConfig",
  "type": "object",
  "description": "Owner-managed weekly branch variance email selection. Evaluations recheck live financial permissions, company membership and branch access. Contains configuration and delivery metadata, not ledger amounts.",
  "properties": {
    "setting_key": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "threshold_pp": {
      "type": "number",
      "default": 10
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "branch"
            ]
          },
          "company_id": {
            "type": "string"
          },
          "branch_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "company_id",
          "branch_id"
        ]
      }
    },
    "revision": {
      "type": "string"
    },
    "last_checked_at": {
      "type": "string"
    },
    "last_period": {
      "type": "string"
    },
    "last_outcome": {
      "type": "string"
    },
    "last_note": {
      "type": "string"
    },
    "delivery_week": {
      "type": "string"
    },
    "delivery_state": {
      "type": "string",
      "enum": [
        "prepared",
        "sent"
      ]
    },
    "delivery_token": {
      "type": "string"
    }
  },
  "required": [
    "setting_key",
    "owner_user_id",
    "enabled",
    "threshold_pp",
    "targets",
    "revision"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}