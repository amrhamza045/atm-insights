{
  "name": "UiTranslation",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "description": "Original English UI string (exact, trimmed)"
    },
    "target": {
      "type": "string",
      "description": "Arabic translation"
    }
  },
  "required": [
    "source",
    "target"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_settings": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_settings": true
          }
        }
      ]
    }
  }
}