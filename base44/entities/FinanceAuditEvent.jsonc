{
  "name": "FinanceAuditEvent",
  "type": "object",
  "description": "Append-only server-recorded Finance changes. Viewing through financeWorkspace rechecks live audit permission, company membership and branch scope. Prior history is not reconstructed.",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "user",
        "automatic_posting"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "approve",
        "reject",
        "reversal"
      ]
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "entity_label": {
      "type": "string"
    },
    "before": {
      "type": [
        "object",
        "null"
      ]
    },
    "after": {
      "type": "object"
    },
    "changed_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "source_entity": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "actor_id",
    "actor_email",
    "actor_type",
    "request_id",
    "action",
    "entity_type",
    "after",
    "changed_fields"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "id": "__service_role_only__"
    },
    "update": {
      "id": "__service_role_only__"
    },
    "delete": {
      "id": "__service_role_only__"
    }
  }
}