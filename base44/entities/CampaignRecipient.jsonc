{
  "name": "CampaignRecipient",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "description": "Campaign ID"
    },
    "campaign_name": {
      "type": "string",
      "description": "Campaign name"
    },
    "client_id": {
      "type": "string",
      "description": "Client ID"
    },
    "client_email": {
      "type": "string",
      "description": "Client email"
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "opened",
        "clicked"
      ],
      "default": "pending",
      "description": "Delivery status"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "When it was sent"
    },
    "error_message": {
      "type": "string",
      "description": "Error if failed"
    }
  },
  "required": [
    "campaign_id",
    "client_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_marketing_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_clients_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_clients_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_analytics_view": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_actions": true
          }
        },
        {
          "user_condition": {
            "data.perm_clients_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_systems": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_actions": true
          }
        },
        {
          "user_condition": {
            "data.perm_clients_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_systems": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_actions": true
          }
        },
        {
          "user_condition": {
            "data.perm_clients_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_systems": true
          }
        }
      ]
    }
  }
}