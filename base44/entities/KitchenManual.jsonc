{
  "name": "KitchenManual",
  "type": "object",
  "properties": {
    "section_key": {
      "type": "string",
      "description": "Unique key identifying the manual section (e.g. '1_business_profile', '4_5_recipe_card')"
    },
    "section_number": {
      "type": "string",
      "description": "Section number as in the template (e.g. '1', '4.5', '5.3')"
    },
    "section_title_en": {
      "type": "string",
      "description": "Section title in English"
    },
    "section_title_ar": {
      "type": "string",
      "description": "Section title in Arabic"
    },
    "section_type": {
      "type": "string",
      "enum": [
        "general",
        "recipe_food",
        "recipe_beverage",
        "recipe_shisha",
        "sop",
        "checklist",
        "log",
        "table",
        "onboarding"
      ],
      "description": "Type of section"
    },
    "main_category": {
      "type": "string",
      "enum": [
        "kitchen",
        "bar",
        "shisha",
        "operations"
      ],
      "default": "operations",
      "description": "Main category: kitchen, bar, shisha, or operations (for non-recipe sections)"
    },
    "item_category": {
      "type": "string",
      "description": "Item category name (e.g. Appetizer, Salad) for recipe entries"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch this entry belongs to (null = all branches)"
    },
    "branch_name": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "ar",
        "both"
      ],
      "default": "en"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "needs_revision"
      ],
      "default": "draft",
      "description": "Approval workflow status"
    },
    "content_en": {
      "type": "object",
      "description": "English content - flexible JSON object storing all fields for the section"
    },
    "content_ar": {
      "type": "object",
      "description": "Arabic content - flexible JSON object storing all fields for the section"
    },
    "menu_item_id": {
      "type": "string",
      "description": "Linked MenuItem ID if this is a food/beverage/shisha recipe card"
    },
    "menu_item_name": {
      "type": "string",
      "description": "Linked menu item name"
    },
    "menu_category": {
      "type": "string",
      "description": "Menu category"
    },
    "dine_in_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of dine-in presentation photos"
    },
    "delivery_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of delivery packaging/presentation photos"
    },
    "prepared_by": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "next_review_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "section_key",
    "section_number",
    "section_title_en"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_is_staff": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_kds_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_menu_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_inventory_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_kds_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_menu_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_inventory_edit": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_menu_edit": true
          }
        }
      ]
    }
  }
}