{
  "name": "CateringEquipmentCategory",
  "type": "object",
  "description": "Equipment categories added by staff from Operations \u203a Assets and Resources \u203a Equipment. Items keep their category as text (CateringEquipment.category); these records add the name to every category picker and show it as an empty group until an item uses it. Names are kept unique (ignoring case) by the add dialog.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name offered in the equipment category picker"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_view": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_settings_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_inventory_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_settings_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_inventory_edit": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_settings_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_inventory_edit": true
          }
        }
      ]
    }
  }
}