{
  "name": "Animal",
  "type": "object",
  "properties": {
    "tag_number": {
      "type": "string",
      "description": "Unique tag/ID number",
      "unique": true
    },
    "species": {
      "type": "string",
      "enum": [
        "cattle",
        "buffalo",
        "sheep",
        "goat",
        "ostrich",
        "rabbit"
      ],
      "default": "cattle",
      "description": "Animal species"
    },
    "breed": {
      "type": "string",
      "description": "Breed"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "unknown"
      ],
      "default": "unknown",
      "description": "Sex"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID of source supplier"
    },
    "supplier_name": {
      "type": "string",
      "description": "Name of source supplier"
    },
    "date_received": {
      "type": "string",
      "format": "date",
      "description": "Date received"
    },
    "live_weight": {
      "type": "number",
      "description": "Live weight"
    },
    "weight_unit": {
      "type": "string",
      "default": "kg",
      "description": "Weight unit"
    },
    "purchase_cost": {
      "type": "number",
      "default": 0,
      "description": "Purchase cost"
    },
    "status": {
      "type": "string",
      "enum": [
        "alive",
        "scheduled_slaughter",
        "slaughtered",
        "deceased_pre_slaughter",
        "rejected_returned"
      ],
      "default": "alive",
      "description": "Animal status"
    },
    "processing_batch_id": {
      "type": "string",
      "description": "ID of processing batch assigned to"
    },
    "closure_reason": {
      "type": "string",
      "description": "Reason for closure (death/rejection)"
    },
    "loss_booked": {
      "type": "boolean",
      "default": false,
      "description": "Whether purchase cost was booked as a full loss"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "tag_number",
    "species",
    "live_weight"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_butchery_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_butchery_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_analytics_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_finance_view": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_butchery_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_butchery_edit": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_butchery_edit": true
          }
        }
      ]
    }
  }
}