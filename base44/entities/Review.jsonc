{
  "name": "Review",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "ID of the branch this review belongs to"
    },
    "branch_name": {
      "type": "string",
      "description": "Name of the branch this review belongs to"
    },
    "menu_item_id": {
      "type": "string",
      "description": "ID of the menu item being reviewed"
    },
    "menu_item_name": {
      "type": "string",
      "description": "Name of the menu item"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client who wrote the review"
    },
    "client_name": {
      "type": "string",
      "description": "Name of the client"
    },
    "order_id": {
      "type": "string",
      "description": "ID of the order where they purchased this item"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating from 1 to 5 stars"
    },
    "review_text": {
      "type": "string",
      "description": "Review comment"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "flagged",
        "rejected"
      ],
      "default": "approved",
      "description": "Review moderation status"
    },
    "flagged_reason": {
      "type": "string",
      "description": "Reason for flagging if status is flagged"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin notes about the review"
    }
  },
  "required": [
    "menu_item_id",
    "client_id",
    "rating"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_review_moderate": true
          }
        },
        {
          "user_condition": {
            "data.perm_analytics_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_is_staff": true
          }
        },
        {
          "data.client_id": "{{user.data.perm_client_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_review_moderate": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_actions": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_review_moderate": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_actions": true
          }
        }
      ]
    }
  }
}