{
  "name": "CateringCostException",
  "type": "object",
  "description": "Manual post-event cost or loss not captured by imported source records (breakage, overtime, extra depletion). Voided rather than deleted for audit.",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "equipment",
        "labor",
        "transport",
        "other"
      ],
      "default": "other"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "voided"
      ],
      "default": "active"
    },
    "recorded_by": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "voided_by": {
      "type": "string"
    },
    "voided_at": {
      "type": "string",
      "format": "date-time"
    },
    "void_reason": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "branch_id",
    "category",
    "amount",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_catering_view": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_catering_finance": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_catering_finance": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "id": "__service_role_only__"
    }
  }
}