{
  "name": "Table",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "ID of the branch this table belongs to"
    },
    "branch_name": {
      "type": "string",
      "description": "Name of the branch this table belongs to"
    },
    "table_number": {
      "type": "string",
      "description": "Table number or identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "empty",
        "occupied"
      ],
      "default": "empty",
      "description": "Current status of the table"
    },
    "current_order_id": {
      "type": "string",
      "description": "ID of the current order on this table"
    },
    "merged_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of tables merged with this one"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this table is active/available"
    },
    "capacity": {
      "type": "number",
      "description": "Seating capacity"
    },
    "minimum_charge_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether minimum charge is enabled for this table"
    },
    "minimum_charge_per_guest": {
      "type": "number",
      "default": 0,
      "description": "Minimum charge amount per guest"
    },
    "minimum_charge_guests": {
      "type": "number",
      "default": 0,
      "description": "Number of guests for minimum charge calculation"
    }
  },
  "required": [
    "table_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_is_staff": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_settings": true
          }
        },
        {
          "user_condition": {
            "data.perm_settings_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_is_staff": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_settings": true
          }
        }
      ]
    }
  }
}