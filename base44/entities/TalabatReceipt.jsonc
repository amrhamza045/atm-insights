{
  "name": "TalabatReceipt",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "ID of the branch where this Talabat receipt was processed"
    },
    "branch_name": {
      "type": "string",
      "description": "Name of the branch where this Talabat receipt was processed"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client created or updated from this receipt"
    },
    "client_name": {
      "type": "string",
      "description": "Customer name extracted from the Talabat receipt photo"
    },
    "mobile_number": {
      "type": "string",
      "description": "Customer mobile number extracted from the receipt photo"
    },
    "customer_address": {
      "type": "string",
      "description": "Customer delivery address extracted from the receipt photo"
    },
    "address_qr_code": {
      "type": "string",
      "description": "Location QR code content / URL decoded from the receipt photo"
    },
    "qr_code_image_url": {
      "type": "string",
      "description": "URL of the cropped QR code image extracted from the receipt (for receipt printing)"
    },
    "raw_extraction": {
      "type": "string",
      "description": "Full raw extraction result from the AI vision model (JSON string)"
    },
    "order_id": {
      "type": "string",
      "description": "ID of the order created from this receipt (if linked)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processed",
        "linked"
      ],
      "default": "pending",
      "description": "Processing status of this receipt"
    }
  },
  "required": [
    "client_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_audit": true
          }
        },
        {
          "user_condition": {
            "data.perm_analytics_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_delivery_view": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_edit": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_audit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        }
      ]
    }
  }
}