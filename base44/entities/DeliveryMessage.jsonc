{
  "name": "DeliveryMessage",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID of the related order (null for general delivery chat)"
    },
    "order_label": {
      "type": "string",
      "description": "Short label for the order (e.g., #1234 - Customer Name)"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "message_text": {
      "type": "string",
      "description": "Message content"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "status_update",
        "system"
      ],
      "default": "text",
      "description": "Type of message"
    },
    "status_value": {
      "type": "string",
      "description": "For status_update messages: the new delivery status"
    },
    "delivery_company_name": {
      "type": "string",
      "description": "Delivery company context for this message"
    }
  },
  "required": [
    "sender_name",
    "message_text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_delivery_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_delivery_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        }
      ]
    }
  }
}