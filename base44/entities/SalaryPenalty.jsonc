{
  "name": "SalaryPenalty",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "ID of the branch this penalty belongs to"
    },
    "branch_name": {
      "type": "string",
      "description": "Name of the branch this penalty belongs to"
    },
    "employee_id": {
      "type": "string",
      "description": "ID of the employee"
    },
    "employee_name": {
      "type": "string",
      "description": "Name of the employee"
    },
    "penalty_type": {
      "type": "string",
      "enum": [
        "late_arrival",
        "absence",
        "misconduct",
        "damage",
        "early_leave",
        "other"
      ],
      "default": "other",
      "description": "Type of penalty"
    },
    "amount": {
      "type": "number",
      "description": "Penalty amount in EGP"
    },
    "description": {
      "type": "string",
      "description": "Reason / details"
    },
    "incident_date": {
      "type": "string",
      "format": "date",
      "description": "Date the incident occurred"
    },
    "apply_to_month": {
      "type": "string",
      "format": "date",
      "description": "Which payroll month to apply this to (YYYY-MM-01)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "cancelled"
      ],
      "default": "pending",
      "description": "Penalty status"
    },
    "applied_salary_record_id": {
      "type": "string",
      "description": "ID of the salary record this was applied to"
    },
    "created_by": {
      "type": "string",
      "description": "Email of admin who created this penalty"
    }
  },
  "required": [
    "employee_id",
    "amount",
    "incident_date",
    "apply_to_month"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "data.employee_id": "{{user.data.perm_employee_id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_view": true
              }
            },
            {
              "user_condition": {
                "data.perm_has_branch": false
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_view": true
              }
            },
            {
              "data.branch_id": "{{user.data.perm_branch_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "user_condition": {
                "data.perm_has_branch": false
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "data.branch_id": "{{user.data.perm_branch_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "user_condition": {
                "data.perm_has_branch": false
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "data.branch_id": "{{user.data.perm_branch_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "user_condition": {
                "data.perm_has_branch": false
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "data.branch_id": "{{user.data.perm_branch_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "user_condition": {
                "data.perm_has_branch": false
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "data.branch_id": "{{user.data.perm_branch_id}}"
            }
          ]
        }
      ]
    }
  }
}