{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "ID of the branch this purchase order belongs to"
    },
    "branch_name": {
      "type": "string",
      "description": "Name of the branch this purchase order belongs to"
    },
    "order_number": {
      "type": "string",
      "description": "Unique purchase order number",
      "unique": true
    },
    "inventory_category_id": {
      "type": "string",
      "description": "ID of the inventory category"
    },
    "inventory_category_name": {
      "type": "string",
      "description": "Name of the inventory category"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "inventory_item_id": {
            "type": "string",
            "description": "ID of the inventory item"
          },
          "inventory_item_name": {
            "type": "string",
            "description": "Name of the inventory item"
          },
          "quantity_ordered": {
            "type": "number",
            "description": "Quantity ordered (in purchase unit)"
          },
          "purchase_unit": {
            "type": "string",
            "description": "Purchase unit type: weight or pcs"
          },
          "purchase_unit_label": {
            "type": "string",
            "description": "Label for purchase unit (kg, box, etc.)"
          },
          "selling_unit": {
            "type": "string",
            "description": "Selling unit type: weight or pcs"
          },
          "selling_unit_label": {
            "type": "string",
            "description": "Label for selling unit"
          },
          "received_selling_qty": {
            "type": "number",
            "description": "Actual quantity received in selling unit. Used to update stock."
          },
          "unit": {
            "type": "string",
            "description": "Legacy unit label"
          },
          "unit_price": {
            "type": "number",
            "description": "Price per purchase unit"
          },
          "total_price": {
            "type": "number",
            "description": "Quantity * Unit Price"
          },
          "approval_status": {
            "type": "string",
            "description": "Per-item approval: approved, rejected, or pending",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "current_stock": {
            "type": "number",
            "description": "Snapshot of current stock at time of review"
          },
          "catering_shortfall_quantity": {
            "type": "number",
            "description": "Shortfall quantity this line was raised to cover (catering-triggered orders only)"
          }
        }
      },
      "description": "Items in the purchase order"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID of the supplier"
    },
    "supplier": {
      "type": "string",
      "description": "Supplier name"
    },
    "supplier_contact": {
      "type": "string",
      "description": "Supplier contact information"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "description": "Date the order was placed"
    },
    "expected_delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Expected delivery date"
    },
    "total_amount": {
      "type": "number",
      "description": "Total order amount"
    },
    "status": {
      "type": "string",
      "enum": [
        "recommended",
        "pending_approval",
        "pending",
        "confirmed",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "pending_approval",
      "description": "Purchase order status. 'recommended' is the starting state of an order generated by the catering Recommended Purchase Cart: it is a draft suggestion that has NOT been approved and must still pass the normal creator-vs-approver review gate before it becomes purchasable. No stock ever moves on a status change \u2014 stock only moves when a PurchaseInvoice is processed."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "created_by_email": {
      "type": "string",
      "description": "Email of the user who raised the PO \u2014 used to keep creator and approver separate"
    },
    "order_source": {
      "type": "string",
      "enum": [
        "regular",
        "catering"
      ],
      "default": "regular",
      "description": "Regular purchasing or an order raised on behalf of a catering event"
    },
    "catering_event_id": {
      "type": "string",
      "description": "Primary CateringEvent this order was raised for (catering orders only). For multi-event orders this mirrors the earliest event in catering_event_ids so existing single-event views keep working."
    },
    "catering_event_name": {
      "type": "string",
      "description": "Name of the primary catering event"
    },
    "catering_event_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the primary catering event this order must arrive for"
    },
    "catering_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every CateringEvent this order covers. A cart built from one event stores a single entry here; a cart built from a date range stores all of them. This is the authoritative link \u2014 the scalar catering_event_id fields are only a mirror of the earliest event for display continuity."
    },
    "catering_event_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Snapshot of the event names at the time the order was raised, positionally aligned with catering_event_ids, so a renamed or deleted event still reads correctly on historical orders"
    },
    "catering_trigger": {
      "type": "string",
      "enum": [
        "shortfall",
        "planning_horizon"
      ],
      "description": "Whether the order was raised by a detected stock shortfall or proactively within the planning horizon"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "routine",
        "urgent"
      ],
      "default": "routine",
      "description": "Urgent = blocking an imminent catering event; shown as a flag in the purchasing queue"
    },
    "needed_by_date": {
      "type": "string",
      "format": "date",
      "description": "Date the goods must be on hand by"
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Reason the order was cancelled"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of admin who reviewed the PO"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the PO was reviewed"
    },
    "purchase_recorded_invoice_id": {
      "type": "string",
      "description": "PurchaseInvoice generated when the real purchase was recorded. Its presence is what proves stock has actually been received for this order \u2014 the status alone never moves stock."
    },
    "purchase_recorded_by": {
      "type": "string",
      "description": "Email of the user who recorded the real purchase"
    },
    "purchase_recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the real purchase was recorded and stock was updated"
    },
    "rfq_status": {
      "type": "string",
      "enum": [
        "open",
        "quoted",
        "converted"
      ],
      "description": "RFQ lifecycle stage: 'open' (waiting for supplier prices), 'quoted' (prices saved on RFQ), 'converted' (verified and turned into a PO)"
    },
    "rfq_number": {
      "type": "string",
      "description": "Original RFQ reference number before conversion to a Purchase Order"
    },
    "rfq_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the RFQ was created"
    },
    "rfq_quoted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when supplier quoted prices were recorded"
    },
    "rfq_quoted_by": {
      "type": "string",
      "description": "Email of the staff member who recorded the supplier quoted prices"
    },
    "rfq_converted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the RFQ was verified and converted into a Purchase Order"
    },
    "rfq_converted_by": {
      "type": "string",
      "description": "Email of the staff member who converted the RFQ into a Purchase Order"
    },
    "receipt_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when received quantities were confirmed"
    },
    "receipt_confirmed_by": {
      "type": "string",
      "description": "Email of the staff member who confirmed the received quantities"
    }
  },
  "required": [
    "order_number",
    "items",
    "total_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_purchase_approve": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_purchase_view": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_purchase_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_inventory_view": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_inventory_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_catering_view": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_purchase_approve": true
          }
        },
        {
          "user_condition": {
            "data.perm_purchase_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_inventory_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_purchase_approve": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_purchase_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_inventory_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_catering_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_purchase_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_inventory_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}