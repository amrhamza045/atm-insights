{
  "name": "Return",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "ID of the branch this return belongs to"
    },
    "branch_name": {
      "type": "string",
      "description": "Name of the branch this return belongs to"
    },
    "session_id": {
      "type": "string",
      "description": "ID of the cashier session"
    },
    "order_id": {
      "type": "string",
      "description": "ID of the order being returned"
    },
    "order_reference": {
      "type": "string",
      "description": "Order reference number"
    },
    "return_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time of return"
    },
    "original_amount": {
      "type": "number",
      "description": "Original order amount"
    },
    "refund_amount": {
      "type": "number",
      "description": "Amount to refund (may be partial)"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "visa",
        "wallet",
        "instapay",
        "cashback_balance"
      ],
      "description": "Original payment method"
    },
    "reason": {
      "type": "string",
      "description": "Reason for return"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "completed",
        "cancelled"
      ],
      "default": "completed",
      "description": "Return status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "session_id",
    "order_id",
    "return_date",
    "original_amount",
    "refund_amount",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_return_approve": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_cashier_view": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_finance_view": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_return_approve": true
          }
        },
        {
          "user_condition": {
            "data.perm_cashier_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_return_approve": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        }
      ]
    }
  }
}