{
  "name": "RestaurantLocation",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "ID of the branch this location belongs to"
    },
    "branch_name": {
      "type": "string",
      "description": "Name of the branch this location belongs to"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude of restaurant location"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude of restaurant location"
    },
    "radius_meters": {
      "type": "number",
      "default": 20,
      "description": "Allowed radius in meters for attendance verification"
    },
    "location_name": {
      "type": "string",
      "description": "Name/description of location"
    }
  },
  "required": [
    "latitude",
    "longitude"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_is_staff": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_settings": true
          }
        },
        {
          "user_condition": {
            "data.perm_settings_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_settings": true
          }
        },
        {
          "user_condition": {
            "data.perm_settings_edit": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_settings": true
          }
        }
      ]
    }
  }
}