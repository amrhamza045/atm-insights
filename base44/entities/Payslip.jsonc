{
  "name": "Payslip",
  "type": "object",
  "description": "Detailed monthly payslip generated when payroll is run. Stays pending_review until payroll staff dispatch it to the employee.",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Employee record id"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "branch_name": {
      "type": "string"
    },
    "month": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-01"
    },
    "net_salary": {
      "type": "number",
      "default": 0
    },
    "detail": {
      "type": "object",
      "description": "Itemised snapshot: earnings, overtime lines, deduction lines, advance installments, totals"
    },
    "pdf_file_uri": {
      "type": "string",
      "description": "Private file reference of the generated PDF"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "dispatched"
      ],
      "default": "pending_review"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "dispatched_at": {
      "type": "string",
      "format": "date-time"
    },
    "dispatched_by": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "month"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "data.employee_id": "{{user.data.perm_employee_id}}"
            },
            {
              "data.status": "dispatched"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_view": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        }
      ]
    }
  }
}