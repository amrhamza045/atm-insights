{
  "name": "FinanceHealthAnalysis",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "currency_decimals": {
      "type": "integer"
    },
    "is_test": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "cutoff": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ]
    },
    "started_by_id": {
      "type": "string"
    },
    "original_summary": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "domains": {
      "type": "object"
    },
    "observations": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "lock_token": {
      "type": "string",
      "default": ""
    },
    "last_review_at": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "status",
    "cutoff",
    "started_by_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}