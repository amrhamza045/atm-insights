{
  "name": "FinanceCustody",
  "type": "object",
  "description": "Per-person financial custody sub-ledger account reporting to the unified CUSTODY_CONTROL_ACC GL summary account. Each employee may hold at most one active custody per company. Mutated only by backend functions under the company finance lock.",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "branch_name": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "active"
    },
    "currency": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Current available custody balance. Payouts and settlements that exceed this balance are blocked."
    },
    "total_funded": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "opened_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "branch_id",
    "employee_id",
    "employee_name",
    "status",
    "currency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_finance_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_finance_edit": true
          }
        },
        {
          "data.employee_id": "{{user.data.perm_employee_id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    },
    "update": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    },
    "delete": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    }
  }
}