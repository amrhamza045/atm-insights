{
  "name": "User",
  "type": "object",
  "properties": {
    "portal_client_id": {
      "type": "string",
      "description": "Catering customer portal link: the Client record this account may see catering data for. Set only on external customer accounts, by staff invitation. Written only by admin/server functions.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "portal_client_name": {
      "type": "string",
      "description": "Name of the linked client, for display",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_catering_staff": {
      "type": "boolean",
      "default": false,
      "description": "True for internal staff who work the Catering module. Written only by admin/server functions.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "catering_branch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Branch IDs a staff member may see catering records for. Written only by admin/server functions.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_staff": {
      "type": "boolean",
      "description": "Legacy flag on existing accounts; not read by app code. Admin-write only.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "perm_flags": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Synced copy of effective permissions. Server-sync only.",
      "rls": {
        "write": {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        }
      }
    },
    "perm_role": {
      "type": "string",
      "description": "Synced copy of the assigned role key. Server-sync only.",
      "rls": {
        "write": {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        }
      }
    },
    "perm_is_central_admin": {
      "type": "boolean",
      "default": false,
      "description": "Synced: admin under the central rule. Server-sync only.",
      "rls": {
        "write": {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        }
      }
    },
    "perm_is_safety_valve": {
      "type": "boolean",
      "default": false,
      "description": "Synced: true only for the account named in the SAFETY_VALVE_EMAIL app secret. Server-sync only.",
      "rls": {
        "write": {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        }
      }
    },
    "perm_branch_id": {
      "type": "string",
      "description": "Synced permission-record branch (empty = all branches). Server-sync only.",
