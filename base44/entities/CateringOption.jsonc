{
  "name": "CateringOption",
  "type": "object",
  "properties": {
    "list_type": {
      "type": "string",
      "enum": [
        "event_type",
        "service_style",
        "dress_code",
        "package_category"
      ],
      "description": "Which admin-managed catering list this option belongs to"
    },
    "name": {
      "type": "string",
      "description": "Display name of the option"
    },
    "description": {
      "type": "string",
      "description": "Optional description shown to planners"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive options stay on historical events but are hidden from new selections"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within the list"
    }
  },
  "required": [
    "list_type",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_is_staff": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_settings_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_settings_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_edit": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_settings_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_edit": true
          }
        }
      ]
    }
  }
}