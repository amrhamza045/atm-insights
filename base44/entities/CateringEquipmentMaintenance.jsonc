{
  "name": "CateringEquipmentMaintenance",
  "type": "object",
  "properties": {
    "equipment_id": {
      "type": "string"
    },
    "equipment_name": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_code": {
      "type": "string"
    },
    "reservation_id": {
      "type": "string",
      "description": "Equipment reservation responsible for this damage."
    },
    "checkin_key": {
      "type": "string",
      "unique": true,
      "description": "Idempotency key for the damage record generated by equipment check-in."
    },
    "record_type": {
      "type": "string",
      "enum": [
        "maintenance",
        "damage"
      ],
      "default": "maintenance"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "default": "open"
    },
    "quantity_affected": {
      "type": "number",
      "default": 1
    },
    "description": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "resolved_date": {
      "type": "string",
      "format": "date-time"
    },
    "cost": {
      "type": "number",
      "minimum": 0,
      "description": "Total repair cost in EGP for the whole record, NOT per piece. Damage check-in requires a manually entered positive amount; no automatic zero default."
    },
    "event_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "equipment_id",
    "record_type"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "damage"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "required": [
          "cost"
        ],
        "properties": {
          "cost": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_inventory_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_analytics_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_finance_view": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_inventory_edit": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_inventory_edit": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_catering_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_inventory_edit": true
          }
        }
      ]
    }
  }
}