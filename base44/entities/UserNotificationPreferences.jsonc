{
  "name": "UserNotificationPreferences",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID of the client"
    },
    "email": {
      "type": "string",
      "description": "Client email"
    },
    "phone": {
      "type": "string",
      "description": "Client phone number for SMS"
    },
    "push_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable browser push notifications"
    },
    "push_token": {
      "type": "string",
      "description": "Push notification token"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable email notifications"
    },
    "sms_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable SMS notifications"
    },
    "order_updates": {
      "type": "boolean",
      "default": true,
      "description": "Notify about order status changes"
    },
    "order_placed": {
      "type": "boolean",
      "default": true,
      "description": "Notify when order is placed"
    },
    "order_preparing": {
      "type": "boolean",
      "default": true,
      "description": "Notify when order is being prepared"
    },
    "order_ready": {
      "type": "boolean",
      "default": true,
      "description": "Notify when order is ready"
    },
    "order_completed": {
      "type": "boolean",
      "default": true,
      "description": "Notify when order is completed"
    },
    "promotions": {
      "type": "boolean",
      "default": true,
      "description": "Receive promotional notifications"
    },
    "new_menu_items": {
      "type": "boolean",
      "default": true,
      "description": "Notify about new menu items"
    },
    "special_offers": {
      "type": "boolean",
      "default": true,
      "description": "Notify about special offers and discounts"
    },
    "cashback_updates": {
      "type": "boolean",
      "default": true,
      "description": "Notify about cashback earnings"
    },
    "referral_updates": {
      "type": "boolean",
      "default": true,
      "description": "Notify about referral activities"
    },
    "payout_approvals": {
      "type": "boolean",
      "default": true,
      "description": "Notify about payout status"
    },
    "tier_updates": {
      "type": "boolean",
      "default": true,
      "description": "Notify about tier level changes"
    }
  },
  "required": [
    "client_id",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}