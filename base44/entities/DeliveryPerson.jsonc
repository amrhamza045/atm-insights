{
  "name": "DeliveryPerson",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "ID of the branch this delivery person belongs to"
    },
    "branch_name": {
      "type": "string",
      "description": "Name of the branch this delivery person belongs to"
    },
    "name": {
      "type": "string",
      "description": "Full name of delivery person"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "motorcycle",
        "car",
        "bicycle",
        "scooter"
      ],
      "description": "Type of vehicle used for delivery"
    },
    "vehicle_number": {
      "type": "string",
      "description": "Vehicle plate/registration number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "busy",
        "offline"
      ],
      "default": "active",
      "description": "Current availability status"
    },
    "current_orders": {
      "type": "number",
      "default": 0,
      "description": "Number of active deliveries"
    },
    "total_deliveries": {
      "type": "number",
      "default": 0,
      "description": "Total completed deliveries"
    },
    "rating": {
      "type": "number",
      "default": 5,
      "description": "Average rating (1-5)"
    },
    "assigned_zones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of zones this person can deliver to"
    },
    "total_bonus_earnings": {
      "type": "number",
      "default": 0,
      "description": "Total bonus earnings from delivery milestones"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "id": "{{user.data.perm_delivery_person_id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_view": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_cashier_view": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_cashier_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.perm_hr_edit": true
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.perm_has_branch": false
                  }
                },
                {
                  "data.branch_id": "{{user.data.perm_branch_id}}"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}