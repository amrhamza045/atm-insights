{
  "name": "PerformanceAppraisal",
  "type": "object",
  "description": "Performance appraisal with independent review. Written only by the employeeLifecycle function.",
  "properties": {
    "employee_record_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "rating": {
      "type": "number"
    },
    "assessment": {
      "type": "string"
    },
    "goals": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "proposed_by": {
      "type": "string"
    },
    "proposed_by_id": {
      "type": "string"
    },
    "proposed_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_by": {
      "type": "string"
    },
    "decided_by_id": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_note": {
      "type": "string"
    }
  },
  "required": [
    "employee_record_id",
    "period_start",
    "period_end",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_hr_edit": true
          }
        },
        {
          "user_condition": {
            "data.perm_hr_approve": true
          }
        },
        {
          "$and": [
            {
              "data.employee_record_id": "{{user.data.perm_employee_id}}"
            },
            {
              "data.status": "approved"
            }
          ]
        }
      ]
    },
    "create": {
      "id": "__service_role_only__"
    },
    "update": {
      "id": "__service_role_only__"
    },
    "delete": {
      "id": "__service_role_only__"
    }
  }
}