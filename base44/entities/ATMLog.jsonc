{
  "name": "ATMLog",
  "type": "object",
  "properties": {
    "terminal_id": {
      "type": "string",
      "description": "Terminal ID"
    },
    "module_name": {
      "type": "string",
      "description": "Module Name"
    },
    "event": {
      "type": "string",
      "description": "Event"
    },
    "fault_type": {
      "type": "string",
      "description": "Fault Type"
    },
    "branch": {
      "type": "string",
      "description": "Branch"
    },
    "vendor": {
      "type": "string",
      "description": "Vendor"
    },
    "type": {
      "type": "string",
      "description": "Type"
    },
    "rule": {
      "type": "string",
      "description": "Rule"
    },
    "last_processing_step": {
      "type": "string",
      "description": "Last Processing Step"
    },
    "starting_from": {
      "type": "string",
      "format": "date-time",
      "description": "Starting From"
    },
    "ending_at": {
      "type": "string",
      "format": "date-time",
      "description": "Ending At"
    },
    "duration": {
      "type": "string",
      "description": "Duration"
    },
    "solved_by": {
      "type": "string",
      "description": "Solved By"
    },
    "maintenance_remark": {
      "type": "string",
      "description": "Maintenance Remark"
    },
    "upload_batch_id": {
      "type": "string",
      "description": "Upload Batch ID - timestamp when logs were uploaded"
    }
  },
  "required": [
    "terminal_id"
  ]
}