{
  "name": "Payout",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID of the client requesting payout"
    },
    "client_name": {
      "type": "string",
      "description": "Name of the client"
    },
    "client_email": {
      "type": "string",
      "description": "Email of the client"
    },
    "amount": {
      "type": "number",
      "description": "Payout amount requested"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "paypal",
        "cash",
        "instapay_transfer",
        "wallet_transfer"
      ],
      "default": "bank_transfer",
      "description": "Preferred payment method"
    },
    "payment_details": {
      "type": "string",
      "description": "Payment details (account number, PayPal email, mobile number, etc.)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "rejected"
      ],
      "default": "pending",
      "description": "Status of the payout"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection if applicable"
    },
    "processed_by": {
      "type": "string",
      "description": "Admin who processed the payout"
    },
    "transaction_reference": {
      "type": "string",
      "description": "Payment transaction reference number"
    },
    "receipt_url": {
      "type": "string",
      "description": "URL to transfer receipt or proof of payment"
    }
  },
  "required": [
    "client_id",
    "amount",
    "payment_method",
    "payment_details"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_finance_view": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_actions": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_systems": true
          }
        },
        {
          "user_condition": {
            "data.perm_payouts_approve": true
          }
        },
        {
          "data.client_id": "{{user.data.perm_client_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_actions": true
          }
        },
        {
          "user_condition": {
            "data.perm_admin_operations": true
          }
        },
        {
          "user_condition": {
            "data.perm_payouts_approve": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perm_is_central_admin": true
          }
        }
      ]
    }
  }
}