  "whatsapp_greeting": "\u0623\u0647\u0644\u0627\u064b \u0628\u064a\u0643! \ud83d\udc4b \ud83c\udf7d\ufe0f \u062a\u062d\u0628 \u062a\u0633\u062a\u0643\u0634\u0641 \u0628\u0627\u0643\u062f\u062c\u0627\u062a \u0627\u0644\u0643\u0627\u062a\u0631\u064a\u0646\u062c \u0628\u062a\u0627\u0639\u062a\u0646\u0627 \u0648\u062a\u0644\u0627\u0642\u064a \u0627\u0644\u0623\u0646\u0633\u0628 \u0644\u0645\u0646\u0627\u0633\u0628\u062a\u0643 (\u0623\u0641\u0631\u0627\u062d\u060c \u0625\u064a\u0641\u0646\u062a\u0627\u062a \u0634\u0631\u0643\u0627\u062a\u060c \u062d\u0641\u0644\u0627\u062a\u060c \u062a\u062c\u0645\u0639\u0627\u062a \u0639\u0627\u0626\u0644\u064a\u0629 \u0648\u063a\u064a\u0631\u0647\u0627)\u061f",
